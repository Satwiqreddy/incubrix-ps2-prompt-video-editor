# every setting the service reads (all optional)
DATA_DIR=./data
PUBLIC_URL=http://localhost:8000
API_TOKEN=                    # if set, clients send Authorization: Bearer <token>
RATE_LIMIT_PER_MIN=120        # per client IP, 0 = off
FFMPEG_BIN=                   # default: ffmpeg on PATH, else imageio-ffmpeg
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
TRANSCRIBER=auto              # auto (uploaded words.json if given, else Whisper) | sidecar | whisper | mock
WHISPER_MODEL=base.en
NLU=rules                     # rules | llm
LLM_API_URL=https://api.anthropic.com/v1/messages
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
STORAGE=local                 # local | s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=incubrix-editor
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CALLBACK_SECRET=change-me     # HMAC-SHA256 key for X-IncuBrix-Signature
SNAP_CUTS=true                # move cuts that land inside a word to the nearest silence
LOW_CONF=0.6                  # words below this confidence are flagged
MAX_SPEED=4
MIN_SPEED=0.25
MIN_CAPTION_S=0.7
MAX_UPLOAD_MB=500
